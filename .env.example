# YouTube Live Chat Bridge - Environment Variables
# Copy this file to .env and fill in your values

# YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=your_api_key_here

# Your YouTube live stream video ID
# Found in the URL: youtube.com/watch?v=VIDEO_ID_HERE
VIDEO_ID=your_video_id_here

# WebSocket port (default: 8765)
WS_PORT=8765

# How often to poll YouTube for new messages (milliseconds, default: 5000)
POLL_INTERVAL=5000

# Hockey overlay: which team's match to show (name or short code, e.g. USA).
# Stamped into every broadcast; overlay picks it up automatically.
# HOCKEY_TEAM=USA

# Subscriber goal widget (top-right overlay): target + poll rate.
# Counts up to SUB_GOAL using the Data API above (quota-funded, polled slowly).
# SUB_GOAL=500
# SUB_POLL_INTERVAL=60000
# CHANNEL_ID=UCQtCMKPc41MHd7hujVuGm5g

# --- MultiStream Configuration ---
# The input stream URL (e.g. OBS streaming to local RTMP or UDP)
INPUT_STREAM_URL=rtmp://127.0.0.1/live/obs

# Twitch
ENABLE_TWITCH=false
TWITCH_STREAM_KEY=your_twitch_stream_key_here

# Kick
ENABLE_KICK=false
KICK_STREAM_KEY=your_kick_stream_key_here

# LLM Integration (OpenAI API Compatible)
LLM_API_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_MODEL=qwen3-0.6b

# Instagram
ENABLE_INSTAGRAM=false
INSTAGRAM_STREAM_KEY=your_instagram_stream_key_here
